;; defsrc is still necessary
(defcfg
  process-unmapped-keys yes
)

(defsrc
  tab q w e r t y u i o p
  caps a s d f h j k l ;
  spc
)
(defvar
  tap-time 150
  hold-time 200
)

(defalias
  escctrl (tap-hold $tap-time $hold-time esc (layer-toggle bs))
  mouse (tap-hold $tap-time $hold-time tab (layer-toggle mouse))
  a (tap-hold $tap-time $hold-time a lsft)
  s (tap-hold $tap-time $hold-time s lctl)
  d (tap-hold $tap-time $hold-time d lalt)
  f (tap-hold $tap-time $hold-time f lmet)
  j (tap-hold $tap-time $hold-time j rmet)
  k (tap-hold $tap-time $hold-time k ralt)
  l (tap-hold $tap-time $hold-time l rctl)
  ; (tap-hold $tap-time $hold-time ; rsft)
)

(deflayer base
  @mouse _ _ _ _ _ _ _ _ _ _
  @escctrl @a @s @d @f _ @j @k @l @;
  spc
)
(deflayer bs
  @mouse 1 2 3 4 5 6 7 8 9 0
  @escctrl _ _ _ _ left down up right enter
  bspc
)  
(defvar
 mwheel-interval 5
 mwheel-distance 5
 mousemove-interval 5
 mousemove-accel-time 1000
 mousemove-min 1
 mousemove-max 15
)
(deflayer mouse
  @mouse _ (mwheel-down $mwheel-interval $mwheel-distance) (mwheel-up $mwheel-interval $mwheel-distance) mrgt _ _ _ _ _ _
  @escctrl _ _ _ _ (movemouse-accel-left $mousemove-interval $mousemove-accel-time $mousemove-min $mousemove-max) (movemouse-accel-down $mousemove-interval $mousemove-accel-time $mousemove-min $mousemove-max) (movemouse-accel-up $mousemove-interval $mousemove-accel-time $mousemove-min $mousemove-max) (movemouse-accel-right $mousemove-interval $mousemove-accel-time $mousemove-min $mousemove-max) _
  mlft
)  
 
